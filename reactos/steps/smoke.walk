# DOES THE PUBLISHED REACTOS DISK REACH ITS DESKTOP? Boot it with no CD, read the desktop, stop.
#
# THIS IS THE CLAIM THE INSTALL LEG CANNOT MAKE, and ReactOS is a guest where the two claims really do
# differ: the install runs 38 steps and ends with a disk, but only a boot of that disk says whether the
# boot sector, the FAT partition and the copied system agree with each other.
#
# NO ISO IS ATTACHED. The only thing that can produce a desktop here is the published disk, so a live
# CD's desktop cannot be mistaken for an installed one - which matters because REACTOS'S LIVE CD AND
# ITS INSTALLED SYSTEM DRAW NEARLY THE SAME DESKTOP. The witness below is the one that separates them.
#
# BIOS AND i440fx, LIKE THE INSTALL LEG. ReactOS 0.4.16 is i386 with no amd64 release and no UEFI
# loader, so there is no pflash and no OVMF; `-machine pc` is the board its own QEMU page names, and
# the target is `-drive if=ide` because the release carries no virtio-blk driver.
#
# THE FRAME IS 800x600 BECAUSE THE GUEST DRAWS 800x600. MEASURED: ReactOS's own display page says
# `VESA Display (800x600x32)` and it keeps that mode once installed, so every reading below is a
# region of an 800x600 frame. Nothing here clicks, so the engine's 1920x1080 rule for `click:` never
# applies.
walkthrough "the published reactos disk reaches its desktop"
resolution 1920x1080
recording_resolution 1920x1080

step "boot the published disk"
  boot
    machine "pc,accel=kvm"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "2"], ["-m", "1024"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "piix3-usb-uhci,id=uhci"], ["-device", "usb-tablet,bus=uhci.0"], ["-device", "usb-kbd,bus=uhci.0"], ["-drive", "file=disk.qcow2,if=ide,index=0,media=disk,format=qcow2,id=target"], ["-netdev", "user,id=net0"], ["-device", "rtl8139,netdev=net0"]]
    timeout 600

# THE WITNESS IS THE DESKTOP'S OWN ICON LABELS, AND THE GATE ACCEPTS TWO READINGS OF THEM.
#
# MEASURED TWICE, and the two readings differ - which is why there are two word-sets:
#
#	locally, on the installed disk      "Computer  My Network  Recycle Bin  Applications ..."
#	in CI, on the same disk (run 45455212639)   "My (c) Read Me - 4 Documents 4 - a My 5 ..."
#
# The second reading is the SAME desktop with the icon column read differently: `Documents` survives
# where `Recycle Bin` did not, and the leg went on to fail a gate on a screen that was plainly the
# desktop. Both are icon labels on the wallpaper, so the gate takes either.
#
# WHAT THE GATE MUST NOT BE IS A WIZARD WORD. An earlier version used `[[computer]]`, and ReactOS's
# setup page says "This wizard installs ReactOS on your **computer**" - so it fired on the WIZARD and
# published a disk still sitting on page one of the second stage. `Documents` and `Recycle Bin` are
# drawn only by the finished system.
step "the desktop is up"
  repeat
    do
      item
        wait 10
      item
        read
          name desk
    until
      source desk
      mode text
      rect [0, 0, 800, 600]
      rect_at [800, 600]
      scale 1
      words [[recycle, bin], [documents]]
    max 60

step "record the desktop"
  settle 30